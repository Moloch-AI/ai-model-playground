# Copy to .env and fill in. Never commit .env.
# The server reads .env from the project root at start; variables already set in the
# environment win over the file. The same file works with "docker run --env-file .env": write
# values without quotes and without comments after them (Docker keeps both as part of the value).

# Required. Create a key in the dashboard: https://dash.molochai.dev/account?utm_source=github&utm_medium=oss&utm_campaign=ai-model-playground
# Keys are not scoped (they can read account details and create invoices): keep this on the server.
# For the mock server use: mock-key
MOLOCHAI_API_KEY=your-api-key

# Optional. Default: https://api.molochai.dev/api/v1
# For the mock server: http://127.0.0.1:4010/api/v1 (in Docker, 127.0.0.1 is the container itself)
MOLOCHAI_BASE_URL=

# Where the playground listens. Defaults: HOST=127.0.0.1 and PORT=8787 (the Docker image sets
# HOST=0.0.0.0; leave these commented out when you pass this file to Docker). On any address other
# than a loopback one, the server refuses to start without PLAYGROUND_ACCESS_TOKEN.
# HOST=127.0.0.1
# PORT=8787

# Shared secret that browsers must send. Required when HOST is not a loopback address.
# At least 16 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
PLAYGROUND_ACCESS_TOKEN=

# Docker only: start without a token although the server listens on 0.0.0.0 in the container.
# Set it only when the port is published on the host's 127.0.0.1 (docker run -p 127.0.0.1:8787:8787).
# See docs/deployment.md.
# PLAYGROUND_ALLOW_NO_TOKEN=true

# Optional tuning (defaults shown)
# PLAYGROUND_RATE_LIMIT=60            # /api requests per minute per client address, 0 = off
# PLAYGROUND_MAX_BODY_BYTES=4194304   # largest accepted chat request body
# PLAYGROUND_TRUST_PROXY=false        # true behind a reverse proxy that sets X-Forwarded-For
